{
    # Railway handles HTTPS, so turn off auto-HTTPS
    admin off
    persist_config off
    auto_https off
}

:{$PORT} {
    root * /app/dist
    file_server
    
    # Enable SPA routing fallback
    try_files {path} /index.html

    # Prevent aggressive caching of the entrypoint on iOS WebKit
    @html {
        path *.html
    }
    header @html {
        Cache-Control "no-cache, no-store, must-revalidate"
        Pragma "no-cache"
        Expires "0"
    }

    # Custom Defensive Security Headers
    header {
        X-Frame-Options "SAMEORIGIN"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=self"
        Content-Security-Policy "default-src 'self' data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://checkout.razorpay.com https://*.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https: https://*.razorpay.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https: http: https://lumberjack.razorpay.com https://api.razorpay.com https://*.razorpay.com; frame-src 'self' blob: data: https: https://checkout.razorpay.com https://api.razorpay.com https://*.razorpay.com;"
    }
}
